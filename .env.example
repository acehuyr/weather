# ---------------------------------------------------------------
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored - never commit real keys.
#
# Everything this project uses is FREE:
#   Weather data  Open-Meteo     no key needed
#   Map tiles     OpenStreetMap  no key needed
#   Location      ip-api.com     no key needed
#   Language model Groq free tier  free key, no card
# ---------------------------------------------------------------

# Which provider writes the answers: groq | anthropic | none
LLM_BACKEND=groq

# ---- Groq (free) ----------------------------------------------
# Get a key at https://console.groq.com/keys - sign in, create key,
# paste below. No credit card. Free tier is rate-limited, not billed.
# Leave blank to run in offline mode (rule-based planner + templates);
# all data analysis, anomaly detection and retrieval still work.
GROQ_API_KEY=

# Open-weight models served free on Groq. Groq retires model IDs without
# notice - a 404 saying 'model does not exist' means yours was pulled, not
# that your key is wrong. List what your account can see with:
#   python scripts/list_models.py
#   openai/gpt-oss-120b   (default - best quality, 131k context)
#   qwen/qwen3.8-27b      (lighter, very fast)
GROQ_MODEL=openai/gpt-oss-120b

# ---- Anthropic (paid - optional alternative) -------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# ---- Retrieval -------------------------------------------------
# Run `python -m src.cli index` after changing this.
#   hash                  lexical, zero-install, the default
#   sentence-transformers semantic, needs: pip install sentence-transformers
#   hybrid                both, fused with RRF - best measured Recall@4
EMBEDDING_BACKEND=hash

# Vector store backend: "simple" (numpy, default) or "chroma"
VECTOR_BACKEND=simple

LOG_LEVEL=INFO
